	/* 骨架屏样式 */
.skeleton-card.data-v-6a122881 {
		padding: 24rpx;
}
.skeleton-header.data-v-6a122881 {
		display: flex;
		align-items: center;
		margin-bottom: 20rpx;
}
.skeleton-avatar.data-v-6a122881 {
		width: 80rpx;
		height: 80rpx;
		border-radius: 50%;
		background-color: #f0f2f5;
		margin-right: 20rpx;
}
.skeleton-info.data-v-6a122881 {
		flex: 1;
}
.skeleton-line.data-v-6a122881 {
		height: 24rpx;
		background-color: #f0f2f5;
		border-radius: 8rpx;
		margin-bottom: 12rpx;
}
.skeleton-content .skeleton-line.data-v-6a122881:last-child {
		margin-bottom: 0;
}
@keyframes skeleton-blink-6a122881 {
0% { opacity: 1;
}
50% { opacity: 0.6;
}
100% { opacity: 1;
}
}
.skeleton-card .skeleton-avatar.data-v-6a122881,
	.skeleton-card .skeleton-line.data-v-6a122881 {
		animation: skeleton-blink-6a122881 1.5s infinite ease-in-out;
}

