.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f0f0f0;
}
.chat-header {
  height: 120rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #eee;
}
.chat-header .chat-header-left, .chat-header .chat-header-right {
  width: 80rpx;
  display: flex;
  justify-content: center;
}
.chat-header .chat-header-middle {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.chat-header .chat-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-bottom: 5rpx;
}
.chat-header .chat-username {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}
.chat-header .chat-status {
  font-size: 24rpx;
  color: #4CAF50;
}
.task-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.task-card .task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}
.task-card .task-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.task-card .task-reward {
  font-size: 28rpx;
  color: #FF5722;
  font-weight: bold;
}
.task-card .task-details {
  display: flex;
  flex-direction: column;
  margin-bottom: 15rpx;
}
.task-card .task-details text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.task-card .task-status {
  font-size: 26rpx;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
  text-align: center;
}
.task-card .task-status.pending {
  color: #FF9800;
  background: #FFF8E1;
}
.task-card .task-status.processing {
  color: #2196F3;
  background: #E3F2FD;
}
.task-card .task-status.completed {
  color: #4CAF50;
  background: #E8F5E9;
}
.task-card .task-status.cancelled {
  color: #F44336;
  background: #FFEBEE;
}
.chat-messages {
  flex: 1;
  overflow: hidden;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #f0f0f0;
}
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  color: #999;
  font-size: 26rpx;
}
.loading-more text {
  margin-left: 10rpx;
}
.message-container {
  margin-bottom: 30rpx;
}
.message-container .system-message {
  text-align: center;
  padding: 10rpx 20rpx;
}
.message-container .system-message text {
  font-size: 24rpx;
  color: #999;
  background: rgba(0, 0, 0, 0.05);
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
}
.message-container .trade-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.message-container .trade-card .card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}
.message-container .trade-card .card-content {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}
.message-container .trade-card .card-actions {
  display: flex;
  justify-content: center;
}
.message-container .trade-card .card-result {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  font-size: 28rpx;
  color: #4CAF50;
}
.message-container .trade-card .card-result text {
  margin-left: 10rpx;
}
.message-container .card-button {
  background: #07C160;
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 0 40rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
}
.message-container .card-button.confirm {
  background: #2196F3;
}
.message-container .other-message {
  display: flex;
  align-items: flex-start;
}
.message-container .other-message .message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}
.message-container .other-message .message-content {
  max-width: 70%;
}
.message-container .other-message .sender-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}
.message-container .self-message {
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
}
.message-container .self-message .message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  margin-left: 20rpx;
}
.message-container .self-message .message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.message-container .self-message .sender-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}
.message-container .message-bubble {
  position: relative;
  padding: 20rpx 25rpx;
  border-radius: 12rpx;
  min-height: 80rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.message-container .other-message .message-bubble {
  background-color: #fff;
  border-top-left-radius: 0;
}
.message-container .self-message .message-bubble {
  background-color: #95ec69;
  border-top-right-radius: 0;
}
.message-container .message-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
}
.message-container .message-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
  text-align: right;
}
.message-container .message-status {
  position: absolute;
  bottom: 15rpx;
  right: 15rpx;
  display: flex;
  align-items: center;
}
.chat-input-area {
  height: 110rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  border-top: 1rpx solid #eee;
}
.chat-input-area .input-left {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}
.chat-input-area .input-left uni-icons {
  margin-right: 25rpx;
}
.chat-input-area .input-center {
  flex: 1;
}
.chat-input-area .input-center .input-text {
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}
.chat-input-area .input-right {
  margin-left: 20rpx;
}
.chat-input-area .input-right .send-button {
  height: 80rpx;
  min-width: 120rpx;
  line-height: 80rpx;
  background-color: #07C160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0 30rpx;
}
.chat-input-area .input-right .send-button[disabled] {
  background-color: #ccc;
}
.chat-input-area .input-right .card-button {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #2196F3;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0 25rpx;
}
.task-menu {
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx;
}
.task-menu .menu-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #eee;
}
.task-menu .menu-item:last-child {
  border-bottom: none;
}
.task-menu .menu-item uni-icons {
  margin-right: 20rpx;
}
.task-menu .menu-item text {
  font-size: 30rpx;
  color: #333;
}
.rotating {
  animation: rotating 1s linear infinite;
}
@keyframes rotating {
from {
    transform: rotate(0deg);
}
to {
    transform: rotate(360deg);
}
}