
.message-center-container.data-v-bad41071 {
  min-height: 100vh;
  background: #f6f8fc;
  display: flex;
  flex-direction: column;
}
.navbar.data-v-bad41071 {
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #e0e6f1;
  box-shadow: 0 2rpx 8rpx rgba(160,180,220,0.08);
}
.navbar-title.data-v-bad41071 {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 2rpx;
}
.navbar-action.data-v-bad41071 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #666;
}
.action-text.data-v-bad41071 {
  margin-left: 6rpx;
  font-size: 28rpx;
  color: #666;
}

/* 顶部功能按钮横向滚动区 */
.function-buttons.data-v-bad41071 {
  width: 100%;
  background: #fff;
  padding: 18rpx 0 8rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(160,180,220,0.04);
  white-space: nowrap;
  overflow-x: auto;
}
.function-button.data-v-bad41071 {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  margin: 0 18rpx;
  position: relative;
  cursor: pointer;
  border-radius: 20rpx;
  transition: background 0.2s;
}
.function-button.active.data-v-bad41071 {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
}
.button-icon.data-v-bad41071 {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f6f8fc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx #e6f7ff80;
}
.button-text.data-v-bad41071 {
  font-size: 26rpx;
  color: #333;
  margin-top: 2rpx;
}
.button-badge.data-v-bad41071 {
  position: absolute;
  top: 10rpx;
  right: 22rpx;
  min-width: 28rpx;
  height: 28rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 20rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-shadow: 0 2rpx 8rpx #ff3b30a0;
  font-weight: bold;
  z-index: 2;
}

/* 对话/消息列表区 */
.conversation-list.data-v-bad41071 {
  flex: 1;
  background: #f6f8fc;
  padding: 0 0 20rpx 0;
}
.message-group.data-v-bad41071 {
  margin: 24rpx 0 0 0;
}
.group-date.data-v-bad41071 {
  font-size: 26rpx;
  color: #8a99b3;
  margin: 0 0 12rpx 32rpx;
  font-weight: 500;
}
.conversation-item.data-v-bad41071 {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 24rpx 18rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(160,180,220,0.10);
  min-height: 110rpx;
  padding: 0 24rpx;
  position: relative;
  transition: box-shadow 0.2s, background 0.2s;
}
.conversation-item.data-v-bad41071:active {
  box-shadow: 0 2rpx 8rpx rgba(58,141,255,0.10);
  background: #e6f7ff;
}
.conversation-item.unread.data-v-bad41071 {
  background: #e6f7ff;
}
.avatar.data-v-bad41071 {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e9f0fb;
  border: 2rpx solid #e0e6f1;
  object-fit: cover;
  margin-right: 20rpx;
}
.conversation-content.data-v-bad41071 {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.conversation-header.data-v-bad41071 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nickname.data-v-bad41071 {
  font-size: 32rpx;
  color: #222;
  font-weight: 500;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
}
.time.data-v-bad41071 {
  font-size: 24rpx;
  color: #bbb;
  margin-left: 12rpx;
}
.message-preview.data-v-bad41071 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.message-text.data-v-bad41071 {
  font-size: 26rpx;
  color: #8a99b3;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.unread-badge.data-v-bad41071 {
  min-width: 36rpx;
  height: 36rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 22rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  margin-left: 12rpx;
  box-shadow: 0 2rpx 8rpx #ff3b30a0;
  font-weight: bold;
}
.interaction-type.data-v-bad41071, .notification-type.data-v-bad41071, .recommend-type.data-v-bad41071 {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #1890ff;
  background: #e6f7ff;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  display: inline-block;
}
.empty-state.data-v-bad41071 {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 30rpx;
}
.loading-state.data-v-bad41071 {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 10rpx 0;
  color: #999;
  font-size: 28rpx;
}
.rotating.data-v-bad41071 {
  animation: rotating-bad41071 1s linear infinite;
}
@keyframes rotating-bad41071 {
from { transform: rotate(0deg);
}
to { transform: rotate(360deg);
}
}
.no-more.data-v-bad41071 {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 20rpx 0 10rpx 0;
}
