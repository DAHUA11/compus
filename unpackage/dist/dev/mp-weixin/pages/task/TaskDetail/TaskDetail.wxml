<view class="container"><view class="task-info"><view class="task-header-flex"><view class="task-title"><block wx:if="{{a}}">求购 - {{b}}</block><block wx:elif="{{c}}">{{d}}</block><block wx:elif="{{e}}">{{f}} - {{g}}</block><block wx:else>{{h}}</block></view><view class="task-type-container"><view class="task-type"><text class="{{['type-tag', j]}}">{{i}}</text><text wx:if="{{k}}" class="urgent-tag">加急</text><text class="{{['task-status-tag', m]}}">{{l}}</text></view></view></view><view class="task-time"><text class="time-label">发布时间：</text><text class="time-value">{{n}}</text></view><view wx:if="{{o}}" class="task-time"><text class="time-label">期望送达时间：</text><text class="time-value">{{p}}</text></view><view class="task-reward"><text class="reward-label">赏金：</text><text class="reward-value">¥{{q}}</text></view><view wx:if="{{r}}" class="task-time"><text class="time-label">商品成色：</text><text class="time-value">{{s}}</text></view></view><view wx:if="{{t}}" class="image-slider"><swiper indicator-dots="{{true}}" autoplay="{{false}}" interval="{{3000}}" duration="{{500}}"><swiper-item wx:for="{{v}}" wx:for-item="image" wx:key="c"><image src="{{image.a}}" mode="aspectFill" class="slider-image" binderror="{{image.b}}"/></swiper-item></swiper></view><view wx:if="{{w}}" class="description-section"><view class="section-title">具体说明</view><view class="description-text">{{x}}</view></view><view wx:if="{{y}}" class="address-section"><view class="section-title">地址信息</view><view class="address-item"><view class="address-label">取件地址：</view><view class="address-content"><text class="address-text">{{z}}</text></view></view><view wx:if="{{A}}" class="address-item"><view class="address-label">快递单号：</view><view class="address-content"><text class="address-text">{{B}}</text></view></view><view class="address-item"><view class="address-label">送达地址：</view><view class="address-content"><text class="address-text">{{C}}</text></view></view></view><view class="publisher-section"><view class="section-title">{{D}}</view><view class="publisher-info"><view wx:if="{{E}}" class="publisher-details"><block wx:if="{{F}}"><text class="contact-info">{{G}}：{{H}}</text><text class="contact-info">联系电话：{{I}}</text></block><block wx:elif="{{J}}"><text class="contact-info">{{K}}：{{L}}</text><text class="contact-info">联系电话：{{M}}</text></block><block wx:else><text class="contact-info">{{N}}：{{O}}</text><text class="contact-info">联系电话：接单后可见</text><text class="privacy-tip">* 为保护发布者隐私，接单后可见完整联系方式</text></block></view><view wx:else class="publisher-details"><image src="{{P}}" class="publisher-avatar"/><text class="publisher-name">{{Q}}</text><text class="publisher-rating">信用等级：{{R}}</text></view></view></view><view class="bottom-bar"><view class="action-buttons"><button wx:if="{{S}}" class="action-button confirm" bindtap="{{T}}"> 确认接单 </button><button wx:if="{{U}}" class="action-button ignore" bindtap="{{V}}"> 暂不考虑 </button><button wx:if="{{W}}" class="action-button start" bindtap="{{X}}"> 发布任务 </button><button wx:if="{{Y}}" class="action-button cancel" bindtap="{{Z}}"> 取消任务 </button></view></view></view>